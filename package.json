{
  "name": "darchive",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm db:generate && pnpm --filter @darchive/web build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "dev": "pnpm db:generate && pnpm --filter @darchive/web dev",
    "lint": "pnpm --filter @darchive/web lint",
    "start": "pnpm --filter @darchive/web start",
    "stocks:sync": "pnpm --filter @darchive/api stocks:sync",
    "test": "pnpm --filter @darchive/api test",
    "typecheck": "pnpm db:generate && pnpm --filter @darchive/api typecheck && pnpm --filter @darchive/web typecheck",
    "wedding:images": "node scripts/process-wedding-images.mjs"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "sharp": "0.34.5"
  }
}
