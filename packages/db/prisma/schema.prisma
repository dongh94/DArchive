generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum WeddingAttendance {
  YES
  NO
}

enum AfterPartyAttendance {
  YES
  NO
  UNDECIDED
}

model WeddingGuestbookEntry {
  id        String                    @id @default(cuid())
  name      String                    @unique @db.VarChar(40)
  message   String                    @db.VarChar(500)
  isVisible Boolean                   @default(true)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  comments  WeddingGuestbookComment[]

  @@index([isVisible, createdAt])
}

model WeddingGuestbookComment {
  id               String                    @id @default(cuid())
  guestbookEntryId String
  parentId         String?
  name             String                    @db.VarChar(40)
  message          String                    @db.VarChar(500)
  isVisible        Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  guestbookEntry   WeddingGuestbookEntry     @relation(fields: [guestbookEntryId], references: [id], onDelete: Cascade)
  parent           WeddingGuestbookComment?  @relation("GuestbookCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          WeddingGuestbookComment[] @relation("GuestbookCommentReplies")

  @@index([guestbookEntryId, isVisible, createdAt])
  @@index([parentId, createdAt])
}

model WeddingRsvp {
  id                   String                @id @default(cuid())
  name                 String                @db.VarChar(40)
  attendance           WeddingAttendance
  guestCount           Int?
  afterPartyAttendance AfterPartyAttendance?
  afterPartyGuestCount Int?
  phone                String?               @db.VarChar(30)
  message              String?               @db.VarChar(500)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([attendance, createdAt])
  @@index([afterPartyAttendance, createdAt])
}

model WeddingPhoto {
  id           String   @id @default(cuid())
  uploaderName String   @db.VarChar(40)
  storagePath  String   @unique @db.VarChar(255)
  publicUrl    String   @db.VarChar(500)
  mimeType     String   @db.VarChar(64)
  mediaType    String   @default("image") @db.VarChar(16)
  byteSize     Int
  width        Int?
  height       Int?
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isVisible, createdAt])
  @@index([createdAt])
  @@index([mediaType, createdAt])
}

enum StockMarket {
  KOSPI
  KOSDAQ
  NYSE
  NASDAQ
  AMEX
}

enum MarketRegion {
  KR
  US
}

enum StrategySide {
  BUY
  SELL
}

model Stock {
  symbol        String         @id @db.VarChar(20)
  name          String         @db.VarChar(100)
  market        StockMarket
  region        MarketRegion   @default(KR)
  sectorName    String?        @db.VarChar(100)
  marketCap     BigInt?
  isCommonShare Boolean        @default(true)
  isActive      Boolean        @default(true)
  updatedAt     DateTime       @updatedAt
  candles       DailyCandle[]
  picks         StrategyPick[]

  @@index([region, isActive])
}

model DailyCandle {
  symbol String   @db.VarChar(20)
  date   DateTime @db.Date
  open   Float
  high   Float
  low    Float
  close  Float
  volume BigInt
  stock  Stock    @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@id([symbol, date])
  @@index([date])
}

model StrategyRun {
  id           String         @id @default(cuid())
  strategyId   String         @db.VarChar(40)
  region       MarketRegion
  side         StrategySide
  asOfDate     DateTime       @db.Date
  universeSize Int
  createdAt    DateTime       @default(now())
  picks        StrategyPick[]

  @@unique([strategyId, region, side, asOfDate])
  @@index([asOfDate])
}

model StrategyPick {
  id        String      @id @default(cuid())
  runId     String
  rank      Int
  symbol    String      @db.VarChar(20)
  score     Float
  eligible  Boolean
  checks    Json
  rationale String      @db.VarChar(1000)
  levels    Json?
  run       StrategyRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stock     Stock       @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([runId, rank])
  @@index([runId, eligible, score])
  @@index([symbol])
}
